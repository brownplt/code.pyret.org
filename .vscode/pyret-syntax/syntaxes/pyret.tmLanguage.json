{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pyret",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#function-defs" },
    { "include": "#function-calls" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.pyret",
          "begin": "#\\|",
          "end": "\\|#"
        },
        {
          "name": "comment.line.number-sign.pyret",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.pyret",
          "begin": "```",
          "end": "```"
        },
        {
          "name": "string.quoted.double.pyret",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.pyret", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.pyret",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.pyret", "match": "\\\\." }
          ]
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.pyret",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rough.pyret",
          "match": "~[0-9]+(\\.[0-9]+)?"
        },
        {
          "name": "constant.numeric.rational.pyret",
          "match": "\\b[0-9]+/[0-9]+\\b"
        },
        {
          "name": "constant.numeric.decimal.pyret",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "function-defs": {
      "comment": "Match 'fun name(' and 'method name(' - assigns scope to name",
      "patterns": [
        {
          "match": "\\b(fun|method|lam)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "keyword.control.pyret" },
            "2": { "name": "entity.name.function.pyret" }
          }
        }
      ]
    },
    "function-calls": {
      "comment": "Any identifier immediately before ( is a function call",
      "patterns": [
        {
          "name": "entity.name.function.pyret",
          "match": "[a-zA-Z_][a-zA-Z0-9_-]*(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "::\\s*([A-Z][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "entity.name.type.pyret" }
          }
        },
        {
          "match": "->\\s*([A-Z][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "entity.name.type.pyret" }
          }
        },
        {
          "match": "\\b(type|newtype|data)\\s+([A-Z][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "keyword.control.pyret" },
            "2": { "name": "entity.name.type.pyret" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pyret",
          "match": "\\b(fun|check|examples|ask|end|when|for|if|else|cases|data|shared|where|with|sharing|doc|otherwise|then|row|source|sanitize|using|because|shadow|var|rec|import|include|provide|from|as|to|is|satisfies|violates|raises|by|ascending|descending|type|newtype|hiding|block|table|load-table|reactor|try|do|select|extend|transform|extract|sieve|order|provide-types|except|letrec|lam|method|not|and|or|ref)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pyret",
          "match": "::|==|=~|<=>|<=|>=|=>|->|:=|\\+|\\*|/|<>|<|>|="
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.pyret",
          "match": "\\b[A-Z][A-Z0-9_-]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.pyret",
          "match": "[a-zA-Z_][a-zA-Z0-9_-]*"
        }
      ]
    }
  },
  "scopeName": "source.pyret"
}
